# Copy to `.env.local` to override. All values are optional.

# Dev only: where Apache serves the PHP backend (Vite proxies /api here).
BACKEND_URL=http://localhost:8080/Lordminds/Real_Estate_CRM/backend

# Base URL the React app uses for API calls. Keep `/api` in development
# (Vite proxy). For a production build, point it at the backend's api folder
# on the same origin, e.g. /Lordminds/Real_Estate_CRM/backend/api
VITE_API_BASE_URL=/api

# Public path the built app is served from (production build only),
# e.g. /Lordminds/Real_Estate_CRM/frontend/dist/
VITE_BASE_PATH=/
